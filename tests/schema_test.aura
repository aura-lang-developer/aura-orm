// ==============================================================================
// Unit Test Suite: Schema & DDL Migrations
// tests/schema_test.aura - Tests Table Definitions and Dialect-Specific DDL
// ==============================================================================

import { PostgresOrm, MysqlOrm, SqliteOrm } from "../src/orm";
import {
  IntegerColumn,
  BigIntColumn,
  StringColumn,
  TextColumn,
  BoolColumn,
  TimestampColumn,
  JsonColumn,
  UuidColumn,
  FloatColumn,
  BlobColumn,
  AddColumnSql,
  DropColumnSql,
  RenameColumnSql
} from "../src/schema/schema";

export fn main(): Unit => {
  let mut passed = 0;
  let mut failed = 0;

  println("================================================================================");
  println("  🧪 AURA-ORM: SCHEMA & DDL MIGRATIONS TEST SUITE");
  println("================================================================================");

  let pg = PostgresOrm();
  let sqlite = SqliteOrm();

  // ----------------------------------------------------------------------------
  // TEST 1: PostgreSQL DDL with SERIAL PRIMARY KEY and DEFAULT
  // ----------------------------------------------------------------------------
  println("\n[TEST 1] PostgreSQL CREATE TABLE DDL:");
  let usersTable = pg.DefineTable("users")
    .AddColumn(IntegerColumn("id").PrimaryKey())
    .AddColumn(StringColumn("name", 100))
    .AddColumn(StringColumn("email", 150).Unique())
    .AddColumn(BoolColumn("is_active").Default("true"))
    .AddColumn(TimestampColumn("created_at"));

  let pgDdl = usersTable.ToCreateTableSql(pg.dialect);
  let expectedPg = "CREATE TABLE IF NOT EXISTS \"users\" (\"id\" SERIAL PRIMARY KEY, \"name\" VARCHAR(100) NOT NULL, \"email\" VARCHAR(150) NOT NULL UNIQUE, \"is_active\" BOOLEAN NOT NULL DEFAULT true, \"created_at\" TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP);";

  if pgDdl == expectedPg {
    println("  ✓ PASS: Correct PostgreSQL DDL generated");
    passed += 1;
  } else {
    println(`  ✕ FAIL: Expected '${expectedPg}'\n       Got: '${pgDdl}'`);
    failed += 1;
  };

  // ----------------------------------------------------------------------------
  // TEST 2: SQLite DDL with AUTOINCREMENT
  // ----------------------------------------------------------------------------
  println("\n[TEST 2] SQLite CREATE TABLE DDL:");
  let tasksTable = sqlite.DefineTable("tasks")
    .AddColumn(IntegerColumn("id").PrimaryKey())
    .AddColumn(TextColumn("description"))
    .AddColumn(BoolColumn("completed").Default("false"));

  let sqliteDdl = tasksTable.ToCreateTableSql(sqlite.dialect);
  let expectedSqlite = "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" INTEGER PRIMARY KEY AUTOINCREMENT, \"description\" TEXT NOT NULL, \"completed\" BOOLEAN NOT NULL DEFAULT false);";

  if sqliteDdl == expectedSqlite {
    println("  ✓ PASS: Correct SQLite DDL with AUTOINCREMENT generated");
    passed += 1;
  } else {
    println(`  ✕ FAIL: Expected '${expectedSqlite}'\n       Got: '${sqliteDdl}'`);
    failed += 1;
  };

  // ----------------------------------------------------------------------------
  // TEST 3: DROP TABLE DDL
  // ----------------------------------------------------------------------------
  println("\n[TEST 3] DROP TABLE IF EXISTS DDL:");
  let dropSql = usersTable.ToDropTableSql(pg.dialect);
  let expectedDrop = "DROP TABLE IF EXISTS \"users\";";

  if dropSql == expectedDrop {
    println("  ✓ PASS: Correct DROP TABLE generated");
    passed += 1;
  } else {
    println(`  ✕ FAIL: Expected '${expectedDrop}' but got '${dropSql}'`);
    failed += 1;
  };

  // ----------------------------------------------------------------------------
  // TEST 4: PostgreSQL Foreign Key with ON DELETE CASCADE
  // ----------------------------------------------------------------------------
  println("\n[TEST 4] PostgreSQL Foreign Key with ON DELETE CASCADE:");
  let itemsTable = pg.DefineTable("order_items")
    .AddColumn(IntegerColumn("id").PrimaryKey())
    .AddColumn(StringColumn("order_id", 64).References("orders", "id").OnDelete("CASCADE"))
    .AddColumn(StringColumn("product_sku", 64));

  let itemsDdl = itemsTable.ToCreateTableSql(pg.dialect);
  let expectedItemsDdl = "CREATE TABLE IF NOT EXISTS \"order_items\" (\"id\" SERIAL PRIMARY KEY, \"order_id\" VARCHAR(64) NOT NULL REFERENCES orders(id) ON DELETE CASCADE, \"product_sku\" VARCHAR(64) NOT NULL);";

  if itemsDdl == expectedItemsDdl {
    println("  ✓ PASS: Correct Foreign Key with ON DELETE CASCADE generated");
    passed += 1;
  } else {
    println(`  ✕ FAIL: Expected '${expectedItemsDdl}'\n       Got: '${itemsDdl}'`);
    failed += 1;
  };

  // ----------------------------------------------------------------------------
  // TEST 5: Table Indexes (CREATE INDEX / CREATE UNIQUE INDEX)
  // ----------------------------------------------------------------------------
  println("\n[TEST 5] Indexes generation:");
  let indexedTable = pg.DefineTable("accounts")
    .AddColumn(IntegerColumn("id").PrimaryKey())
    .AddColumn(StringColumn("email", 120))
    .AddColumn(StringColumn("tenant_id", 64))
    .AddIndex("idx_accounts_email", ["email"], true)
    .AddIndex("idx_accounts_tenant_email", ["tenant_id", "email"], false);

  let indexStatements = indexedTable.ToCreateIndexSql(pg.dialect);
  let expectedIdx1 = "CREATE UNIQUE INDEX IF NOT EXISTS \"idx_accounts_email\" ON \"accounts\" (\"email\");";
  let expectedIdx2 = "CREATE INDEX IF NOT EXISTS \"idx_accounts_tenant_email\" ON \"accounts\" (\"tenant_id\", \"email\");";

  if len(indexStatements) == 2 && indexStatements[0] == expectedIdx1 && indexStatements[1] == expectedIdx2 {
    println("  ✓ PASS: Correct CREATE INDEX and CREATE UNIQUE INDEX generated");
    passed += 1;
  } else {
    println("  ✕ FAIL: Index DDL mismatch");
    failed += 1;
  };

  // ----------------------------------------------------------------------------
  // TEST 6: Modern Column Types (UUID, JSON, FLOAT, BLOB)
  // ----------------------------------------------------------------------------
  println("\n[TEST 6] Modern Column Types (PostgreSQL vs SQLite):");
  let docsTablePg = pg.DefineTable("documents")
    .AddColumn(UuidColumn("doc_id").PrimaryKey())
    .AddColumn(JsonColumn("metadata"))
    .AddColumn(FloatColumn("rating"))
    .AddColumn(BlobColumn("payload"));

  let pgDocDdl = docsTablePg.ToCreateTableSql(pg.dialect);
  let expectedPgDoc = "CREATE TABLE IF NOT EXISTS \"documents\" (\"doc_id\" UUID PRIMARY KEY, \"metadata\" JSONB NOT NULL, \"rating\" FLOAT NOT NULL, \"payload\" BYTEA NOT NULL);";

  if pgDocDdl == expectedPgDoc {
    println("  ✓ PASS: Correct modern types (UUID, JSONB, FLOAT, BYTEA) for PostgreSQL");
    passed += 1;
  } else {
    println(`  ✕ FAIL: Expected '${expectedPgDoc}'\n       Got: '${pgDocDdl}'`);
    failed += 1;
  };

  // ----------------------------------------------------------------------------
  // TEST 7: ALTER TABLE DDL (ADD, DROP, RENAME Column)
  // ----------------------------------------------------------------------------
  println("\n[TEST 7] ALTER TABLE DDL statements:");
  let addColSql = AddColumnSql("users", StringColumn("nickname", 50).Nullable(), pg.dialect);
  let dropColSql = DropColumnSql("users", "old_col", pg.dialect);
  let renameColSql = RenameColumnSql("users", "name", "full_name", pg.dialect);

  let expectedAdd = "ALTER TABLE \"users\" ADD COLUMN \"nickname\" VARCHAR(50);";
  let expectedDropCol = "ALTER TABLE \"users\" DROP COLUMN \"old_col\";";
  let expectedRename = "ALTER TABLE \"users\" RENAME COLUMN \"name\" TO \"full_name\";";

  if addColSql == expectedAdd && dropColSql == expectedDropCol && renameColSql == expectedRename {
    println("  ✓ PASS: ALTER TABLE ADD, DROP and RENAME COLUMN verified");
    passed += 1;
  } else {
    println("  ✕ FAIL: ALTER TABLE statements mismatch");
    failed += 1;
  };

  // ----------------------------------------------------------------------------
  // RESULTS SUMMARY
  // ----------------------------------------------------------------------------
  println("================================================================================");
  println(`  🏁 SUMMARY: ${passed} Passed, ${failed} Failed`);
  println("================================================================================");

  if failed > 0 {
    println("❌ Schema test suite encountered failures!");
  } else {
    println("✅ All schema & migration tests passed successfully!");
  };
}
