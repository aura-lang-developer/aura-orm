// ==============================================================================
// Example 01: SELECT Queries, Filters, Pagination and Joins
// examples/01_select_queries.aura
// ==============================================================================

import { PostgresOrm, MysqlOrm, SqliteOrm } from "../src/orm";

export fn main(): Unit => {
  println("================================================================================");
  println("  📖 EXAMPLE 01: SELECT QUERIES & MULTI-DIALECT PLACEHOLDERS");
  println("================================================================================");

  let pg = PostgresOrm();
  let mysql = MysqlOrm();

  // 1. Basic SELECT with WHERE, Order and Pagination in PostgreSQL
  println("\n--- 1. PostgreSQL SELECT with pagination ($1, $2 placeholders) ---");
  let pgSelect = pg.SelectFrom("users")
    .Select("id")
    .Select("username")
    .Select("email")
    .Where("is_active", "=", "true")
    .Where("age", ">=", "21")
    .OrderBy("created_at", "DESC")
    .Limit(15)
    .Offset(30)
    .ToSql();

  println(`SQL:    ${pgSelect.sql}`);
  println(`PARAMS: [${pgSelect.params[0]}, ${pgSelect.params[1]}]`);

  // 2. MySQL SELECT with '?' placeholders
  println("\n--- 2. MySQL SELECT with '?' placeholders ---");
  let mysqlSelect = mysql.SelectFrom("products")
    .Select("sku")
    .Select("name")
    .Select("price")
    .Where("status", "=", "published")
    .Where("stock", ">", "0")
    .OrderBy("price", "ASC")
    .Limit(10)
    .ToSql();

  println(`SQL:    ${mysqlSelect.sql}`);
  println(`PARAMS: [${mysqlSelect.params[0]}, ${mysqlSelect.params[1]}]`);

  // 3. SELECT with INNER JOIN and IS NULL filter
  println("\n--- 3. SELECT with JOIN and WHERE NULL ---");
  let joinQuery = pg.SelectFrom("orders")
    .Select("orders.id")
    .Select("orders.total_amount")
    .Select("customers.name")
    .Join("INNER", "customers", "orders.customer_id = customers.id")
    .WhereNull("orders.cancelled_at")
    .ToSql();

  println(`SQL:    ${joinQuery.sql}`);
  println("================================================================================");
}
