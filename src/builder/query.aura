  let mut newParams = b.params;
  newParams.push(pattern);
  let ph = FormatPlaceholder(b.dialect, len(newParams));
  let clause = `${column} LIKE ${ph}`;

  let mut newWheres = b.whereClauses;
  if len(newWheres) > 0 {
    newWheres.push(`AND ${clause}`);
  } else {
    newWheres.push(clause);
  };

  {
    __aura_type: "SelectBuilder",
    table: b.table,
    fields: b.fields,
    joins: b.joins,
    whereClauses: newWheres,
    params: newParams,
    groupBys: b.groupBys,
    havingClauses: b.havingClauses,
    orderBys: b.orderBys,
    limitVal: b.limitVal,
