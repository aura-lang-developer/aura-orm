// ==============================================================================
// Aura ORM - Query Builder Module
// src/builder/query.aura - Fluent SQL Builder for SELECT, INSERT, UPDATE, DELETE
// ==============================================================================

import { Dialect, PostgresDialect, QuoteIdentifier, FormatPlaceholder } from "../dialect/dialect";

export struct SqlQuery {
  sql: String,
  params: []String
};

fn joinStrings(list: []String, sep: String): String => {
  let count = len(list);
  if count == 0 {
    ""
  } else {
    let mut res = list[0];
    let mut i = 1;
    while i < count {
      res = `${res}${sep}${list[i]}`;
      i = i + 1;
    }
    res
  }
};

// ==============================================================================
// SELECT Query Builder
// ==============================================================================

export struct SelectBuilder {
  __aura_type: String,
  table: String,
  fields: []String,
  joins: []String,
  whereClauses: []String,
  params: []String,
  groupBys: []String,
  havingClauses: []String,
  orderBys: []String,
  limitVal: Int,
  offsetVal: Int,
  dialect: Dialect
};

export fn NewSelect(table: String, dialect: Dialect): SelectBuilder => {
  let emptyFields: []String = [];
  let emptyJoins: []String = [];
  let emptyWheres: []String = [];
  let emptyParams: []String = [];
  let emptyGroup: []String = [];
  let emptyHaving: []String = [];
  let emptyOrder: []String = [];

  {
    __aura_type: "SelectBuilder",
    table: table,
    fields: emptyFields,
    joins: emptyJoins,
    whereClauses: emptyWheres,
    params: emptyParams,
    groupBys: emptyGroup,
    havingClauses: emptyHaving,
    orderBys: emptyOrder,
    limitVal: -1,
    offsetVal: -1,
    dialect: dialect
  }
};

export fn (b: SelectBuilder) Select(field: String): SelectBuilder => {
  let mut newFields = b.fields;
  newFields.push(field);
  {
    __aura_type: "SelectBuilder",
    table: b.table,
    fields: newFields,
    joins: b.joins,
    whereClauses: b.whereClauses,
    params: b.params,
    groupBys: b.groupBys,
    havingClauses: b.havingClauses,
    orderBys: b.orderBys,
    limitVal: b.limitVal,
    offsetVal: b.offsetVal,
    dialect: b.dialect
  }
};

export fn (b: SelectBuilder) Count(field: String, asAlias: String): SelectBuilder => {
  let expr = if len(asAlias) > 0 { `COUNT(${field}) AS ${asAlias}` } else { `COUNT(${field})` };
  b.Select(expr)
};

export fn (b: SelectBuilder) Sum(field: String, asAlias: String): SelectBuilder => {
  let expr = if len(asAlias) > 0 { `SUM(${field}) AS ${asAlias}` } else { `SUM(${field})` };
  b.Select(expr)
};

export fn (b: SelectBuilder) Avg(field: String, asAlias: String): SelectBuilder => {
  let expr = if len(asAlias) > 0 { `AVG(${field}) AS ${asAlias}` } else { `AVG(${field})` };
  b.Select(expr)
};

export fn (b: SelectBuilder) Min(field: String, asAlias: String): SelectBuilder => {
  let expr = if len(asAlias) > 0 { `MIN(${field}) AS ${asAlias}` } else { `MIN(${field})` };
  b.Select(expr)
};

export fn (b: SelectBuilder) Max(field: String, asAlias: String): SelectBuilder => {
  let expr = if len(asAlias) > 0 { `MAX(${field}) AS ${asAlias}` } else { `MAX(${field})` };
  b.Select(expr)
};

export fn (b: SelectBuilder) Where(column: String, op: String, value: String): SelectBuilder => {
  let mut newParams = b.params;
  newParams.push(value);
  let paramIdx = len(newParams);
  let ph = FormatPlaceholder(b.dialect, paramIdx);
  let clause = `${column} ${op} ${ph}`;

  let mut newWheres = b.whereClauses;
  if len(newWheres) > 0 {
    newWheres.push(`AND ${clause}`);
  } else {
    newWheres.push(clause);
  };

  {
    __aura_type: "SelectBuilder",
    table: b.table,
    fields: b.fields,
    joins: b.joins,
    whereClauses: newWheres,
    params: newParams,
    groupBys: b.groupBys,
    havingClauses: b.havingClauses,
    orderBys: b.orderBys,
    limitVal: b.limitVal,
    offsetVal: b.offsetVal,
    dialect: b.dialect
  }
};

export fn (b: SelectBuilder) OrWhere(column: String, op: String, value: String): SelectBuilder => {
  let mut newParams = b.params;
  newParams.push(value);
  let paramIdx = len(newParams);
  let ph = FormatPlaceholder(b.dialect, paramIdx);
  let clause = `${column} ${op} ${ph}`;

  let mut newWheres = b.whereClauses;
  if len(newWheres) > 0 {
    newWheres.push(`OR ${clause}`);
  } else {
    newWheres.push(clause);
  };

  {
    __aura_type: "SelectBuilder",
    table: b.table,
    fields: b.fields,
    joins: b.joins,
    whereClauses: newWheres,
    params: newParams,
    groupBys: b.groupBys,
    havingClauses: b.havingClauses,
    orderBys: b.orderBys,
    limitVal: b.limitVal,
    offsetVal: b.offsetVal,
    dialect: b.dialect
  }
};

export fn (b: SelectBuilder) WhereNull(column: String): SelectBuilder => {
  let clause = `${column} IS NULL`;
  let mut newWheres = b.whereClauses;
  if len(newWheres) > 0 {
    newWheres.push(`AND ${clause}`);
  } else {
    newWheres.push(clause);
  };

  {
    __aura_type: "SelectBuilder",
    table: b.table,
    fields: b.fields,
    joins: b.joins,
    whereClauses: newWheres,
    params: b.params,
    groupBys: b.groupBys,
    havingClauses: b.havingClauses,
    orderBys: b.orderBys,
    limitVal: b.limitVal,
    offsetVal: b.offsetVal,
    dialect: b.dialect
  }
};

export fn (b: SelectBuilder) WhereNotNull(column: String): SelectBuilder => {
  let clause = `${column} IS NOT NULL`;
  let mut newWheres = b.whereClauses;
  if len(newWheres) > 0 {
    newWheres.push(`AND ${clause}`);
  } else {
    newWheres.push(clause);
  };

  {
    __aura_type: "SelectBuilder",
    table: b.table,
    fields: b.fields,
    joins: b.joins,
    whereClauses: newWheres,
    params: b.params,
    groupBys: b.groupBys,
    havingClauses: b.havingClauses,
    orderBys: b.orderBys,
    limitVal: b.limitVal,
    offsetVal: b.offsetVal,
    dialect: b.dialect
  }
};

export fn (b: SelectBuilder) WhereIn(column: String, values: []String): SelectBuilder => {
  let mut newParams = b.params;
  let mut phs: []String = [];
  for v in values {
    newParams.push(v);
    phs.push(FormatPlaceholder(b.dialect, len(newParams)));
  }
  let inExpr = joinStrings(phs, ", ");
  let clause = `${column} IN (${inExpr})`;

  let mut newWheres = b.whereClauses;
  if len(newWheres) > 0 {
    newWheres.push(`AND ${clause}`);
  } else {
    newWheres.push(clause);
  };

  {
    __aura_type: "SelectBuilder",
    table: b.table,
    fields: b.fields,
    joins: b.joins,
    whereClauses: newWheres,
    params: newParams,
    groupBys: b.groupBys,
    havingClauses: b.havingClauses,
    orderBys: b.orderBys,
    limitVal: b.limitVal,
    offsetVal: b.offsetVal,
    dialect: b.dialect
  }
};

export fn (b: SelectBuilder) WhereNotIn(column: String, values: []String): SelectBuilder => {
  let mut newParams = b.params;
  let mut phs: []String = [];
  for v in values {
    newParams.push(v);
    phs.push(FormatPlaceholder(b.dialect, len(newParams)));
  }
  let inExpr = joinStrings(phs, ", ");
  let clause = `${column} NOT IN (${inExpr})`;

  let mut newWheres = b.whereClauses;
  if len(newWheres) > 0 {
    newWheres.push(`AND ${clause}`);
  } else {
    newWheres.push(clause);
  };

  {
    __aura_type: "SelectBuilder",
    table: b.table,
    fields: b.fields,
    joins: b.joins,
    whereClauses: newWheres,
    params: newParams,
    groupBys: b.groupBys,
    havingClauses: b.havingClauses,
    orderBys: b.orderBys,
    limitVal: b.limitVal,
    offsetVal: b.offsetVal,
    dialect: b.dialect
  }
};

export fn (b: SelectBuilder) WhereBetween(column: String, low: String, high: String): SelectBuilder => {
  let mut newParams = b.params;
  newParams.push(low);
  let phLow = FormatPlaceholder(b.dialect, len(newParams));
  newParams.push(high);
  let phHigh = FormatPlaceholder(b.dialect, len(newParams));
  let clause = `${column} BETWEEN ${phLow} AND ${phHigh}`;

  let mut newWheres = b.whereClauses;
  if len(newWheres) > 0 {
    newWheres.push(`AND ${clause}`);
  } else {
    newWheres.push(clause);
  };

  {
    __aura_type: "SelectBuilder",
    table: b.table,
    fields: b.fields,
    joins: b.joins,
    whereClauses: newWheres,
    params: newParams,
    groupBys: b.groupBys,
    havingClauses: b.havingClauses,
    orderBys: b.orderBys,
    limitVal: b.limitVal,
    offsetVal: b.offsetVal,
    dialect: b.dialect
  }
};

