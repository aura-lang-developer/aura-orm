export fn (b: SelectBuilder) WhereILike(column: String, pattern: String): SelectBuilder => {
  let mut newParams = b.params;
  newParams.push(pattern);
  let ph = FormatPlaceholder(b.dialect, len(newParams));
  let op = if b.dialect.name == "postgres" { "ILIKE" } else { "LIKE" };
  let clause = `${column} ${op} ${ph}`;

  let mut newWheres = b.whereClauses;
  if len(newWheres) > 0 {
    newWheres.push(`AND ${clause}`);
  } else {
    newWheres.push(clause);
  };

  {
    __aura_type: "SelectBuilder",
    table: b.table,
    fields: b.fields,
    joins: b.joins,
    whereClauses: newWheres,
    params: newParams,
    groupBys: b.groupBys,
    havingClauses: b.havingClauses,
    orderBys: b.orderBys,
    limitVal: b.limitVal,
    offsetVal: b.offsetVal,
    dialect: b.dialect
  }
};

export fn (b: SelectBuilder) Join(joinType: String, table: String, onCondition: String): SelectBuilder => {
  let mut newJoins = b.joins;
  newJoins.push(`${joinType} JOIN ${table} ON ${onCondition}`);

  {
    __aura_type: "SelectBuilder",
    table: b.table,
    fields: b.fields,
    joins: newJoins,
    whereClauses: b.whereClauses,
    params: b.params,
    groupBys: b.groupBys,
    havingClauses: b.havingClauses,
    orderBys: b.orderBys,
    limitVal: b.limitVal,
    offsetVal: b.offsetVal,
    dialect: b.dialect
  }
};

export fn (b: SelectBuilder) InnerJoin(table: String, onCondition: String): SelectBuilder => {
  b.Join("INNER", table, onCondition)
};

export fn (b: SelectBuilder) LeftJoin(table: String, onCondition: String): SelectBuilder => {
  b.Join("LEFT", table, onCondition)
};

export fn (b: SelectBuilder) RightJoin(table: String, onCondition: String): SelectBuilder => {
  b.Join("RIGHT", table, onCondition)
};

export fn (b: SelectBuilder) FullJoin(table: String, onCondition: String): SelectBuilder => {
  b.Join("FULL", table, onCondition)
};

export fn (b: SelectBuilder) GroupBy(field: String): SelectBuilder => {
  let mut newGroups = b.groupBys;
  newGroups.push(field);

  {
    __aura_type: "SelectBuilder",
    table: b.table,
    fields: b.fields,
    joins: b.joins,
    whereClauses: b.whereClauses,
    params: b.params,
    groupBys: newGroups,
    havingClauses: b.havingClauses,
    orderBys: b.orderBys,
    limitVal: b.limitVal,
    offsetVal: b.offsetVal,
    dialect: b.dialect
  }
};

export fn (b: SelectBuilder) Having(condition: String): SelectBuilder => {
  let mut newHaving = b.havingClauses;
  if len(newHaving) > 0 {
    newHaving.push(`AND ${condition}`);
  } else {
    newHaving.push(condition);
  };

  {
    __aura_type: "SelectBuilder",
    table: b.table,
    fields: b.fields,
    joins: b.joins,
    whereClauses: b.whereClauses,
    params: b.params,
    groupBys: b.groupBys,
    havingClauses: newHaving,
    orderBys: b.orderBys,
    limitVal: b.limitVal,
    offsetVal: b.offsetVal,
    dialect: b.dialect
  }
};

export fn (b: SelectBuilder) OrderBy(field: String, direction: String): SelectBuilder => {
  let mut newOrders = b.orderBys;
  newOrders.push(`${field} ${direction}`);

  {
    __aura_type: "SelectBuilder",
    table: b.table,
    fields: b.fields,
    joins: b.joins,
    whereClauses: b.whereClauses,
    params: b.params,
    groupBys: b.groupBys,
    havingClauses: b.havingClauses,
    orderBys: newOrders,
    limitVal: b.limitVal,
    offsetVal: b.offsetVal,
    dialect: b.dialect
  }
};

export fn (b: SelectBuilder) Limit(limit: Int): SelectBuilder => {
  {
    __aura_type: "SelectBuilder",
    table: b.table,
    fields: b.fields,
    joins: b.joins,
    whereClauses: b.whereClauses,
    params: b.params,
    groupBys: b.groupBys,
    havingClauses: b.havingClauses,
    orderBys: b.orderBys,
    limitVal: limit,
    offsetVal: b.offsetVal,
    dialect: b.dialect
  }
};

export fn (b: SelectBuilder) Offset(offset: Int): SelectBuilder => {
  {
    __aura_type: "SelectBuilder",
    table: b.table,
    fields: b.fields,
    joins: b.joins,
    whereClauses: b.whereClauses,
    params: b.params,
    groupBys: b.groupBys,
    havingClauses: b.havingClauses,
    orderBys: b.orderBys,
    limitVal: b.limitVal,
    offsetVal: offset,
    dialect: b.dialect
  }
};

export fn (b: SelectBuilder) ToSql(): SqlQuery => {
  let fieldsPart = if len(b.fields) == 0 {
    "*"
  } else {
    joinStrings(b.fields, ", ")
  };

  let mut sql = `SELECT ${fieldsPart} FROM ${b.table}`;

  if len(b.joins) > 0 {
    let joinsPart = joinStrings(b.joins, " ");
    sql = `${sql} ${joinsPart}`;
  };

  if len(b.whereClauses) > 0 {
    let wherePart = joinStrings(b.whereClauses, " ");
    sql = `${sql} WHERE ${wherePart}`;
  };

  if len(b.groupBys) > 0 {
    let groupPart = joinStrings(b.groupBys, ", ");
    sql = `${sql} GROUP BY ${groupPart}`;
  };

  if len(b.havingClauses) > 0 {
    let havingPart = joinStrings(b.havingClauses, " ");
    sql = `${sql} HAVING ${havingPart}`;
  };

  if len(b.orderBys) > 0 {
    let orderPart = joinStrings(b.orderBys, ", ");
    sql = `${sql} ORDER BY ${orderPart}`;
  };

  if b.limitVal >= 0 {
    sql = `${sql} LIMIT ${b.limitVal}`;
  };

  if b.offsetVal >= 0 {
    sql = `${sql} OFFSET ${b.offsetVal}`;
  };

  sql = `${sql};`;

  {
    sql: sql,
    params: b.params
  }
};

// ==============================================================================
// INSERT Query Builder
// ==============================================================================

export struct InsertBuilder {
  __aura_type: String,
  table: String,
  columns: []String,
  values: []String,
  isRawList: []Bool,
  batchRows: [][]String,
  returningCols: []String,
  conflictTarget: String,
  conflictAction: String,
  dialect: Dialect
};

export fn NewInsert(table: String, dialect: Dialect): InsertBuilder => {
  let emptyCols: []String = [];
  let emptyVals: []String = [];
  let emptyRaw: []Bool = [];
  let emptyBatch: [][]String = [];
  let emptyRet: []String = [];

  {
    __aura_type: "InsertBuilder",
    table: table,
    columns: emptyCols,
    values: emptyVals,
    isRawList: emptyRaw,
    batchRows: emptyBatch,
    returningCols: emptyRet,
    conflictTarget: "",
    conflictAction: "",
    dialect: dialect
  }
};

export fn (b: InsertBuilder) Set(column: String, value: String): InsertBuilder => {
  let mut newCols = b.columns;
  newCols.push(column);

  let mut newVals = b.values;
  newVals.push(value);

  let mut newRaw = b.isRawList;
  newRaw.push(false);

  {
    __aura_type: "InsertBuilder",
    table: b.table,
    columns: newCols,
    values: newVals,
    isRawList: newRaw,
    batchRows: b.batchRows,
    returningCols: b.returningCols,
    conflictTarget: b.conflictTarget,
    conflictAction: b.conflictAction,
    dialect: b.dialect
  }
};

export fn (b: InsertBuilder) SetRaw(column: String, rawExpr: String): InsertBuilder => {
  let mut newCols = b.columns;
  newCols.push(column);

  let mut newVals = b.values;
  newVals.push(rawExpr);

  let mut newRaw = b.isRawList;
  newRaw.push(true);

  {
    __aura_type: "InsertBuilder",
    table: b.table,
    columns: newCols,
    values: newVals,
    isRawList: newRaw,
    batchRows: b.batchRows,
    returningCols: b.returningCols,
    conflictTarget: b.conflictTarget,
    conflictAction: b.conflictAction,
    dialect: b.dialect
  }
};

export fn (b: InsertBuilder) BatchInsert(columns: []String, rows: [][]String): InsertBuilder => {
  {
    __aura_type: "InsertBuilder",
    table: b.table,
    columns: columns,
    values: b.values,
    isRawList: b.isRawList,
    batchRows: rows,
    returningCols: b.returningCols,
    conflictTarget: b.conflictTarget,
    conflictAction: b.conflictAction,
    dialect: b.dialect
  }
};

export fn (b: InsertBuilder) Returning(col: String): InsertBuilder => {
  let mut newRet = b.returningCols;
  newRet.push(col);

  {
    __aura_type: "InsertBuilder",
    table: b.table,
    columns: b.columns,
    values: b.values,
    isRawList: b.isRawList,
    batchRows: b.batchRows,
    returningCols: newRet,
    conflictTarget: b.conflictTarget,
    conflictAction: b.conflictAction,
    dialect: b.dialect
  }
};

export fn (b: InsertBuilder) OnConflictDoNothing(conflictTarget: String): InsertBuilder => {
  {
    __aura_type: "InsertBuilder",
    table: b.table,
    columns: b.columns,
    values: b.values,
    isRawList: b.isRawList,
    batchRows: b.batchRows,
    returningCols: b.returningCols,
    conflictTarget: conflictTarget,
    conflictAction: "DO NOTHING",
    dialect: b.dialect
  }
};

export fn (b: InsertBuilder) OnConflictDoUpdate(conflictTarget: String, updateAssignments: []String): InsertBuilder => {
  let updateClause = `DO UPDATE SET ${joinStrings(updateAssignments, ", ")}`;
  {
    __aura_type: "InsertBuilder",
    table: b.table,
    columns: b.columns,
    values: b.values,
    isRawList: b.isRawList,
    batchRows: b.batchRows,
    returningCols: b.returningCols,
    conflictTarget: conflictTarget,
    conflictAction: updateClause,
    dialect: b.dialect
  }
};

export fn (b: InsertBuilder) ToSql(): SqlQuery => {
  let mut placeholders: []String = [];
  let mut paramValues: []String = [];
  let mut paramCounter = 0;

  let colsPart = joinStrings(b.columns, ", ");
  let mut valsPart = "";

  if len(b.batchRows) > 0 {
    let mut rowGroups: []String = [];
    for row in b.batchRows {
      let mut rowPhs: []String = [];
      for v in row {
        paramCounter = paramCounter + 1;
        let ph = FormatPlaceholder(b.dialect, paramCounter);
        rowPhs.push(ph);
        paramValues.push(v);
      }
      rowGroups.push(`(${joinStrings(rowPhs, ", ")})`);
    }
    valsPart = joinStrings(rowGroups, ", ");
  } else {
    let colCount = len(b.columns);
    let mut i = 0;
    while i < colCount {
      if b.isRawList[i] {
        placeholders.push(b.values[i]);
      } else {
        paramCounter = paramCounter + 1;
        let ph = FormatPlaceholder(b.dialect, paramCounter);
        placeholders.push(ph);
        paramValues.push(b.values[i]);
      };
      i = i + 1;
    }
    valsPart = `(${joinStrings(placeholders, ", ")})`;
  };

  let mut sql = `INSERT INTO ${b.table} (${colsPart}) VALUES ${valsPart}`;

  if len(b.conflictTarget) > 0 {
    sql = `${sql} ON CONFLICT (${b.conflictTarget}) ${b.conflictAction}`;
  };

  if len(b.returningCols) > 0 && (b.dialect.name == "postgres" || b.dialect.name == "sqlite") {
    let retPart = joinStrings(b.returningCols, ", ");
    sql = `${sql} RETURNING ${retPart}`;
  };

  sql = `${sql};`;

  {
    sql: sql,
    params: paramValues
  }
};

